<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="oaiResponsesAvalonia.Views.DataSyncWindow"
        Title="Data Sync — experimental" Width="660" Height="220"
        MinWidth="500" MinHeight="180" WindowStartupLocation="CenterOwner">
    <Grid Margin="18" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
        <TextBlock FontSize="19" FontWeight="SemiBold" Text="Data Sync" />
        <TextBlock Grid.Row="1" TextWrapping="Wrap"
                   Text="Choose a provider for experimental conversation backup and verification. Live restore and two-way sync are not available." />
        <Button Grid.Row="2" Content="Proton Drive…" HorizontalAlignment="Left" Click="OpenProton_Click" />
    </Grid>
</Window>
