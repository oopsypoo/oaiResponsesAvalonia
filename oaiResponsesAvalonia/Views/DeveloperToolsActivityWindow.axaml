<Window x:Class="oaiResponsesAvalonia.Views.DeveloperToolsActivityWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:data="using:oaiResponsesAvalonia.Data"
        x:DataType="x:Object"
        x:CompileBindings="True"
        Title="Developer Tools Activity"
        Width="680"
        Height="480"
        MinWidth="420"
        MinHeight="280"
        WindowStartupLocation="CenterOwner">
    <ListBox x:Name="ActivityList"
             Margin="12"
             ItemsSource="{Binding}">
        <ListBox.ItemTemplate>
            <DataTemplate x:DataType="data:DeveloperToolActivityItem">
                <Expander Margin="4,3"
                          HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Spacing="3">
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding Header}" />
                            <TextBlock Opacity="0.8"
                                       Text="{Binding Target}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander.Header>
                    <TextBlock Margin="0,8,0,4"
                               Text="{Binding Details}"
                               TextWrapping="Wrap" />
                </Expander>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</Window>