<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="oaiResponsesAvalonia.Views.ImageGalleryWindow"
        xmlns:local="using:oaiResponsesAvalonia.Views"
        Title="Images"
        Width="1120"
        Height="720"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto" Margin="10" RowSpacing="8">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,180,150" ColumnSpacing="8" VerticalAlignment="Center">
            <Menu Grid.Column="0" VerticalAlignment="Center">
                <MenuItem Header="_File">
                    <MenuItem x:Name="SaveAsMenuItem" Header="Save As…" IsEnabled="False" Click="SaveAsMenuItem_Click" />
                    <MenuItem Header="Import…" Click="ImportButton_Click" />
                    <MenuItem Header="Refresh" Click="RefreshMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="Exit" Click="ExitMenuItem_Click" />
                </MenuItem>
                <MenuItem Header="_Edit">
                    <MenuItem x:Name="NewFolderMenuItem" Header="New Folder…" Click="NewFolderButton_Click" />
                    <Separator />
                    <MenuItem x:Name="DeleteFileMenuItem" Header="Delete File" IsEnabled="False" Click="DeleteFileMenuItem_Click" />
                    <MenuItem x:Name="DeleteFolderMenuItem" Header="Delete Folder" IsEnabled="False" Click="DeleteFolderMenuItem_Click" />
                </MenuItem>
            </Menu>
            <TextBlock Grid.Column="1" Text="Browse:" VerticalAlignment="Center" />
            <ComboBox x:Name="LocationPicker" Grid.Column="2" SelectedIndex="0" SelectionChanged="LocationPicker_SelectionChanged">
                <ComboBoxItem Content="Application Images" />
                <ComboBoxItem Content="User Images" />
            </ComboBox>
            <ComboBox x:Name="CategoryPicker" Grid.Column="3" SelectedIndex="0" SelectionChanged="CategoryPicker_SelectionChanged">
                <ComboBoxItem Content="Responses (resp_)" Tag="responses" />
                <ComboBoxItem Content="User-created (user_)" Tag="user" />
                <ComboBoxItem Content="All images" Tag="all" />
            </ComboBox>
        </Grid>

        <Grid x:Name="GalleryPanel" Grid.Row="1" ColumnDefinitions="2*,5,3*" ColumnSpacing="0">
            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="6">
                <Button x:Name="UpButton" Grid.Row="0" Content="Up" HorizontalAlignment="Stretch" Click="UpButton_Click" />
                <ListBox x:Name="EntriesList" Grid.Row="1" SelectionChanged="EntriesList_SelectionChanged" DoubleTapped="EntriesList_DoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:ImageGalleryItem">
                            <Border Padding="6" Margin="2" BorderThickness="0,0,0,1" BorderBrush="#33000000">
                                <Grid ColumnDefinitions="30,88,*" ColumnSpacing="8" MinHeight="66">
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <Image Grid.Column="1" Source="{Binding Thumbnail}" Width="84" Height="60" Stretch="Uniform" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Details}" Opacity="0.75" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns" />
            <Grid Grid.Column="2" RowDefinitions="*,Auto,Auto" Margin="12,0,0,0" RowSpacing="8">
                <Border Grid.Row="0" Background="#181818" CornerRadius="4" Padding="8">
                    <Image x:Name="PreviewImage" Stretch="Uniform" />
                </Border>
                <TextBlock x:Name="PreviewDetailsText" Grid.Row="1" Text="Select an image to preview it." TextWrapping="Wrap" />
                <Grid Grid.Row="2">
                    <Button x:Name="EditButton" HorizontalAlignment="Right" Content="Edit…" IsEnabled="False" Click="EditButton_Click" />
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="EditorPanel" Grid.Row="1" IsVisible="False" ColumnDefinitions="2*,5,3*">
            <ScrollViewer Grid.Column="0" Margin="0,0,12,0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">
                    <Button Content="← Back to gallery" HorizontalAlignment="Left" Click="BackButton_Click" />
                    <TextBlock x:Name="EditorImageTitle" FontWeight="Bold" TextWrapping="Wrap" />
                    <CheckBox x:Name="CropToolCheckBox" Content="Crop" IsCheckedChanged="CropToolCheckBox_Changed" />
                    <StackPanel x:Name="CropControlsPanel" IsVisible="False" Spacing="6">
                        <TextBlock Text="Drag on the image to draw a crop rectangle; drag inside to move it, or drag an edge or corner to resize it." TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                        <TextBox x:Name="CropXBox" Grid.Row="0" Grid.Column="0" PlaceholderText="X" IsReadOnly="True" />
                        <TextBox x:Name="CropYBox" Grid.Row="0" Grid.Column="1" PlaceholderText="Y" IsReadOnly="True" />
                        <TextBox x:Name="CropWidthBox" Grid.Row="1" Grid.Column="0" PlaceholderText="Width" LostFocus="CropDimensionBox_LostFocus" />
                        <TextBox x:Name="CropHeightBox" Grid.Row="1" Grid.Column="1" PlaceholderText="Height" LostFocus="CropDimensionBox_LostFocus" />
                    </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                            <Button Grid.Column="0" Content="Crop" Click="CropButton_Click" />
                            <Button Grid.Column="1" Content="Clear crop" Click="ClearCropButton_Click" />
                            <Button x:Name="EditCropOnSourceButton" Grid.Column="2" Content="Adjust Crop" IsVisible="False" Click="EditCropOnSourceButton_Click" />
                        </Grid>
                    </StackPanel>
                    <CheckBox x:Name="ResizeToolCheckBox" Content="Resize" IsCheckedChanged="ResizeToolCheckBox_Changed" />
                    <StackPanel x:Name="ResizeControlsPanel" IsVisible="False" Spacing="6">
                        <TextBlock Text="Resize (pixels)" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                        <TextBox x:Name="ResizeWidthBox" Grid.Column="0" PlaceholderText="Width" LostFocus="ProcessingTextBox_LostFocus" />
                        <TextBox x:Name="ResizeHeightBox" Grid.Column="1" PlaceholderText="Height" LostFocus="ProcessingTextBox_LostFocus" />
                    </Grid>
                        <CheckBox x:Name="KeepAspectCheckBox" Content="Keep aspect ratio" IsChecked="True" IsCheckedChanged="ProcessingOption_Changed" />
                    </StackPanel>
                    <CheckBox x:Name="RotationToolCheckBox" Content="Rotate" IsCheckedChanged="RotationToolCheckBox_Changed" />
                    <ComboBox x:Name="RotationPicker" IsVisible="False" SelectedIndex="0" SelectionChanged="ProcessingPicker_SelectionChanged">
                        <ComboBoxItem Content="None" Tag="0" />
                        <ComboBoxItem Content="90° clockwise" Tag="90" />
                        <ComboBoxItem Content="180°" Tag="180" />
                        <ComboBoxItem Content="270° clockwise" Tag="270" />
                    </ComboBox>
                    <CheckBox x:Name="FilterToolCheckBox" Content="Filter" IsCheckedChanged="FilterToolCheckBox_Changed" />
                    <ComboBox x:Name="FilterPicker" IsVisible="False" SelectedIndex="0" SelectionChanged="ProcessingPicker_SelectionChanged">
                        <ComboBoxItem Content="None" Tag="None" />
                        <ComboBoxItem Content="Grayscale" Tag="Grayscale" />
                        <ComboBoxItem Content="Sepia" Tag="Sepia" />
                        <ComboBoxItem Content="Invert" Tag="Invert" />
                    </ComboBox>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">


                    </Grid>
                </StackPanel>
            </ScrollViewer>
            <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns" />
            <Border Grid.Column="2" Background="#181818" CornerRadius="4" Padding="8">
                <Grid>
                    <Image x:Name="EditorPreviewImage" Stretch="Uniform" />
                    <Canvas x:Name="CropOverlayCanvas" Background="Transparent" ClipToBounds="True"
                            PointerPressed="CropOverlayCanvas_PointerPressed"
                            PointerMoved="CropOverlayCanvas_PointerMoved"
                            PointerReleased="CropOverlayCanvas_PointerReleased"
                            PointerCaptureLost="CropOverlayCanvas_PointerCaptureLost"
                            SizeChanged="CropOverlayCanvas_SizeChanged" />
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Text="Ready" TextWrapping="Wrap" />
    </Grid>
</Window>
