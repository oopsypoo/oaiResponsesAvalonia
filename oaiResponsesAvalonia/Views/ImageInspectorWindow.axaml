<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="oaiResponsesAvalonia.Views.ImageInspectorWindow"
        Title="Image Inspector"
        Width="1000"
        Height="720"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto" Margin="10" RowSpacing="8">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6" VerticalAlignment="Center">
            <Button x:Name="PreviousButton" Grid.Column="0" Content="Previous" Click="PreviousButton_Click" />
            <Button x:Name="NextButton" Grid.Column="1" Content="Next" Click="NextButton_Click" />
            <TextBlock x:Name="ImageNameText" Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="3" Content="−" ToolTip.Tip="Zoom out" Click="ZoomOutButton_Click" />
            <TextBlock x:Name="ZoomText" Grid.Column="4" MinWidth="54" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Button Grid.Column="5" Content="+" ToolTip.Tip="Zoom in" Click="ZoomInButton_Click" />
            <Button Grid.Column="6" Content="Fit" Click="FitButton_Click" />
            <Button Grid.Column="7" Content="100%" Click="ActualSizeButton_Click" />
            <Button Grid.Column="8" Content="Save As…" Click="SaveAsButton_Click" />
        </Grid>

        <Border Grid.Row="1" Background="#181818" CornerRadius="4" Padding="8">
            <ScrollViewer x:Name="PreviewScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          ScrollChanged="PreviewScrollViewer_ScrollChanged"
                          PointerWheelChanged="PreviewScrollViewer_PointerWheelChanged"
                          SizeChanged="PreviewScrollViewer_SizeChanged">
                <Canvas x:Name="ImageCanvas" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image x:Name="PreviewImage" Stretch="Fill" />
                </Canvas>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="2" Text="Mouse wheel zooms; scroll to pan when zoomed." TextWrapping="Wrap" />
    </Grid>
</Window>
