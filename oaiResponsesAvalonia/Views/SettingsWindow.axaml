<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="using:oaiResponsesAvalonia"
        x:Class="oaiResponsesAvalonia.Views.SettingsWindow"
        x:DataType="settings:AppSettings"
        Width="620"
        Height="460"
        Title="Settings">
  <Grid Margin="20"
        RowDefinitions="Auto,*,Auto"
        ColumnDefinitions="Auto,*,Auto">
    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Grid.RowSpan="2" Margin="0,0,0,20">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
        <Label Content="App Root:" Width="100" VerticalAlignment="Center"/>
        <TextBox x:Name="AppRootTextBox" Width="300" Text="{Binding AppRoot}" VerticalAlignment="Center"/>
        <Button x:Name="BrowseAppRootBtn" Content="Browse" Width="80" Margin="10,0,0,0" Click="BrowseAppRoot_Click" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
        <Label Content="Images Folder:" Width="100" VerticalAlignment="Center"/>
        <TextBox x:Name="ImagesTextBox" Width="300" Text="{Binding ImagesFolder}" VerticalAlignment="Center"/>
        <Button Content="Browse" Width="80" Margin="10,0,0,0" Click="BrowseImages_Click" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
        <Label Content="User Images:" Width="100" VerticalAlignment="Center"/>
        <TextBox x:Name="SavedImagesFolderTextBox" Width="300" Text="{Binding SavedImagesFolder}" VerticalAlignment="Center" ToolTip.Tip="Choose any folder for images saved by the app. The default 'user' folder is created under Images Folder; an absolute path selects another location."/>
        <Button Content="Browse" Width="80" Margin="10,0,0,0" Click="BrowseSavedImages_Click" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
        <Label Content="Files Folder:" Width="100" VerticalAlignment="Center"/>
        <TextBox x:Name="FilesTextBox" Width="300" Text="{Binding FilesFolder}" VerticalAlignment="Center"/>
        <Button Content="Browse" Width="80" Margin="10,0,0,0" Click="BrowseFiles_Click" VerticalAlignment="Center"/>
      </StackPanel>
      <Border Margin="0,8,0,0" Padding="12" BorderThickness="1" CornerRadius="6">
        <StackPanel Spacing="8">
          <TextBlock Text="Google Safe Browsing API key" FontWeight="Bold"/>
          <TextBlock Text="The key is stored in the operating system credential store, not in the settings file. Use a key restricted to the Safe Browsing API." TextWrapping="Wrap"/>
          <TextBox x:Name="GoogleSafeBrowsingKeyTextBox" PasswordChar="●" PlaceholderText="Paste API key to save or replace"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Save key" Click="SaveGoogleSafeBrowsingKey_Click"/>
            <Button x:Name="RemoveGoogleSafeBrowsingKeyButton" Content="Remove key" Click="RemoveGoogleSafeBrowsingKey_Click" IsEnabled="False"/>
          </StackPanel>
          <TextBlock x:Name="GoogleSafeBrowsingKeyStatusText" Text="Checking credential store…" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </StackPanel>
    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Save" Width="80" Margin="5" Click="Save_Click" IsDefault="True"/>
      <Button Content="Cancel" Width="80" Margin="5,5,0,5" Click="Cancel_Click" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
