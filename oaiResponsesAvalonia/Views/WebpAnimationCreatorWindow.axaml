<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:oaiResponsesAvalonia.Views"
        x:Class="oaiResponsesAvalonia.Views.WebpAnimationCreatorWindow"
        Title="Create animated WebP"
        Width="1320" Height="820" MinWidth="1050" MinHeight="680"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto" Margin="14" RowSpacing="10">
        <TextBlock x:Name="IntroText" Grid.Row="0"
                   Text="Create an animated WebP from still images. Each source file becomes one frame."
                   TextWrapping="Wrap" />

        <Grid Grid.Row="1" ColumnDefinitions="250,5,*,5,320">
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" RowSpacing="8">
                <TextBlock Grid.Row="0" Text="Frames (top to bottom is playback order)" FontWeight="SemiBold" />
                <ListBox x:Name="SourcesList" Grid.Row="1" SelectionChanged="SourcesList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:WebpAnimationSourceItem">
                            <Grid ColumnDefinitions="64,*" ColumnSpacing="10" MinHeight="62" Margin="3">
                                <Image Grid.Column="0" Source="{Binding Thumbnail}" Width="56" Height="54" Stretch="Uniform" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FrameSummary}" FontSize="11" Opacity="0.8" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="5">
                    <Button x:Name="AddFilesButton" Grid.Column="0" Content="Add files…" Click="AddFiles_Click" />
                    <Button x:Name="AddFolderButton" Grid.Column="1" Content="Add folder…" Click="AddFolder_Click" />
                    <Button x:Name="DuplicateButton" Grid.Column="2" Content="Duplicate" Click="DuplicateSelected_Click" />
                    <Button x:Name="MoveUpButton" Grid.Column="3" Content="Move ↑" Click="MoveUp_Click" />
                    <Button x:Name="MoveDownButton" Grid.Column="4" Content="Move ↓" Click="MoveDown_Click" />
                    <Button x:Name="RemoveButton" Grid.Column="5" Content="Remove" Click="RemoveSelected_Click" />
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns" />

            <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto,*" RowSpacing="8">
                <TextBlock Grid.Row="0" Text="Canvas preview — selected frame" FontWeight="Bold" FontSize="16" />
                <Border Grid.Row="1" Background="#202020" BorderBrush="#666666" BorderThickness="1"
                        CornerRadius="4" Padding="8" MinHeight="170">
                    <Grid RowDefinitions="*,Auto" RowSpacing="6">
                        <Image x:Name="CanvasPreviewImage" Grid.Row="0" Stretch="Uniform" />
                        <TextBlock x:Name="CanvasPreviewInfo" Grid.Row="1" HorizontalAlignment="Center"
                                   FontSize="11" Opacity="0.8" />
                    </Grid>
                </Border>
                <Border Grid.Row="2" Background="#303030" BorderBrush="#555555" BorderThickness="1"
                        CornerRadius="4" Padding="8">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Animation playback preview"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White" />
                        <Button x:Name="BuildPreviewButton" Grid.Row="0" Grid.Column="1" Content="Build preview"
                                Click="BuildPreview_Click" Background="#505050" Foreground="White" />
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6"
                                    IsVisible="False" x:Name="PreviewControls">
                            <Button Content="◀" Click="PreviousPreviewFrame_Click" Background="#505050" Foreground="White" />
                            <Button x:Name="PreviewPlayButton" Content="Play" Click="PreviewPlayButton_Click"
                                    Background="#505050" Foreground="White" />
                            <Button Content="▶|" Click="NextPreviewFrame_Click" Background="#505050" Foreground="White" />
                            <TextBlock x:Name="PreviewFrameText" VerticalAlignment="Center" Foreground="White" />
                            <CheckBox x:Name="PreviewLoopForeverCheckBox"
                                      Content="Play indefinitely (ignore repeat count)"
                                      IsCheckedChanged="PreviewLoopForeverCheckBox_Changed" Foreground="White"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="3" Background="#181818" BorderBrush="#444444" BorderThickness="1"
                        CornerRadius="4" Padding="8" MinHeight="150">
                    <Image x:Name="AnimationPreviewImage" Stretch="Uniform" />
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="5" ResizeDirection="Columns" />

            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <TextBlock Text="Frame properties" FontWeight="Bold" FontSize="16" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="5">
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Size (pixels)" />
                        <TextBox x:Name="FrameWidthBox" Grid.Row="1" Grid.Column="0" PlaceholderText="Width"
                                 TextChanged="FrameGeometry_TextChanged" />
                        <TextBox x:Name="FrameHeightBox" Grid.Row="1" Grid.Column="1" PlaceholderText="Height"
                                 TextChanged="FrameGeometry_TextChanged" />
                        <CheckBox x:Name="KeepFrameAspectCheckBox" Grid.Row="2" Grid.ColumnSpan="2"
                                  Content="Keep frame aspect ratio" IsChecked="True"
                                  IsCheckedChanged="KeepFrameAspectCheckBox_Changed" />
                        <TextBox x:Name="FrameXBox" Grid.Row="3" Grid.Column="0" PlaceholderText="X offset"
                                 TextChanged="FrameGeometry_TextChanged" />
                        <TextBox x:Name="FrameYBox" Grid.Row="3" Grid.Column="1" PlaceholderText="Y offset"
                                 TextChanged="FrameGeometry_TextChanged" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Duration (ms)" />
                            <TextBox x:Name="FrameDurationBox" Text="100" TextChanged="FrameSettings_TextChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Blending" />
                            <ComboBox x:Name="BlendModeBox" SelectedIndex="0" SelectionChanged="FrameSettings_SelectionChanged">
                                <ComboBoxItem Content="Do not blend (replace)" />
                                <ComboBoxItem Content="Alpha blend" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="DisposeAfterFrameCheckBox"
                              Content="Restore frame area to background after display" IsChecked="True"
                              IsCheckedChanged="FrameSettings_SelectionChanged" />
                    <Border x:Name="EditModeNotice" IsVisible="False" Background="#FFF4D6" Padding="8" CornerRadius="4">
                        <TextBlock Text="Existing frames are decoded as full-canvas images; durations and animation behavior are loaded where available. Added images use the global defaults. Saving re-encodes the frames as lossy WebP and leaves the source unchanged."
                                   TextWrapping="Wrap" />
                    </Border>

                    <Separator />
                    <TextBlock Text="Animation options" FontWeight="Bold" FontSize="16" />
                    <TextBlock Text="Canvas size (pixels)" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <TextBox x:Name="WidthBox" Grid.Column="0" Text="480" TextChanged="CanvasSize_TextChanged" />
                        <TextBox x:Name="HeightBox" Grid.Column="1" Text="480" TextChanged="CanvasSize_TextChanged" />
                    </Grid>
                    <CheckBox x:Name="FitNewImagesCheckBox"
                              Content="Fit newly added images inside the canvas, preserving aspect ratio" IsChecked="True" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="Default duration for new frames (ms)" TextWrapping="Wrap" />
                        <TextBox x:Name="DefaultDurationBox" Text="100" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Looping" />
                        <CheckBox x:Name="LoopForeverCheckBox" Content="Export loops forever" IsChecked="True"
                                  IsCheckedChanged="LoopForeverCheckBox_Changed" />
                    </StackPanel>
                    <TextBox x:Name="LoopCountBox" PlaceholderText="Finite repeat count" Text="1" IsEnabled="False" />
                    <TextBlock Text="Finite count is the number of repeats after the initial play."
                               FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <TextBox x:Name="MethodBox" Grid.Column="0" PlaceholderText="Method (0–6)" Text="4" />
                        <TextBox x:Name="QualityBox" Grid.Column="1" PlaceholderText="Quality (1–100)" Text="80" />
                    </Grid>
                    <TextBlock Text="Method 0 is fastest; 6 spends more time encoding. Quality is a separate lossy-quality setting."
                               FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                    <TextBox x:Name="OutputNameBox" PlaceholderText="Output filename" Text="animation.webp" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center"
                       Text="Add at least two images." TextWrapping="Wrap" />
            <Button Grid.Column="1" Content="Cancel" IsCancel="True" Click="Cancel_Click" />
            <Button x:Name="CreateButton" Grid.Column="2" Content="Create WebP" IsDefault="True"
                    Click="CreateButton_Click" />
        </Grid>
    </Grid>
</Window>
