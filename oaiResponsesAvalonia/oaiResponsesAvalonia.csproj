<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>oaiResponsesAvalonia</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Remove="Assets\MarkdownViewer\markdown-base.css" />
    <AvaloniaResource Remove="Assets\MarkdownViewer\markdown-viewer.js" />
    <AvaloniaResource Remove="Assets\MarkdownViewer\page-themes\github-dark-page.css" />
    <AvaloniaResource Remove="Assets\MarkdownViewer\page-themes\github-light-page.css" />
    <AvaloniaResource Remove="Assets\MarkdownViewer\README.md" />
    <AvaloniaResource Remove="Assets\MarkdownViewer\template.html" />
    <AvaloniaResource Remove="Assets\MarkdownViewer\viewer-codeblock-fixes.css" />
    <AvaloniaResource Remove="Assets\MarkdownViewer\highlight.min.js" />
    <AvaloniaResource Remove="Assets\MarkdownViewer\Styles\**\*" />
    <AvaloniaXaml Remove="Models\**" />
    <Compile Remove="Models\**" />
    <EmbeddedResource Remove="Models\**" />
    <None Remove="Models\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Markdig" Version="1.1.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\MarkdownViewer\markdown-base.css">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\MarkdownViewer\markdown-viewer.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\MarkdownViewer\page-themes\github-dark-page.css">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\MarkdownViewer\page-themes\github-light-page.css">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\MarkdownViewer\template.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\MarkdownViewer\viewer-codeblock-fixes.css">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\MarkdownViewer\highlight.min.js">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Assets\MarkdownViewer\Styles\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
	<Target Name="DeployToKubuntu" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
		<Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(PublishDir)..\deploy.ps1&quot; -PublishDir &quot;$(PublishDir.TrimEnd('\'))&quot;" />
	</Target>
</Project>
